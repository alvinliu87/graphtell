{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "GraphTell desktop default capabilities: only the local backend and user-selected paths",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:app:default",
    "core:event:default",
    "core:window:default",
    "core:webview:allow-webview-window"
  ]
}
